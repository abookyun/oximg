{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oximg-site",
  "compatibility_date": "2026-09-29",

  // Static-assets-only Worker: no script, `astro build` output is served
  // as-is. The account comes from CLOUDFLARE_ACCOUNT_ID, never this file.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Custom domains create their own proxied DNS records in the oximg.dev
  // zone (the zone itself is managed by OpenTofu, outside this repo). www
  // is redirected to the apex by a zone redirect rule before it reaches
  // this Worker.
  "routes": [
    { "pattern": "oximg.dev", "custom_domain": true },
    { "pattern": "www.oximg.dev", "custom_domain": true }
  ],

  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
