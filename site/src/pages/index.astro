---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Benchmarks from "../components/Benchmarks.astro";
import Quality from "../components/Quality.astro";
import UrlGrammars from "../components/UrlGrammars.astro";
import UsageModes from "../components/UsageModes.astro";
import Details from "../components/Details.astro";
import Limits from "../components/Limits.astro";
---

<Base
  title="oximg — image resizing that's faster and sharper"
  description="A Rust image server, CLI and library for JPEG, PNG, WebP and AVIF. 1.2–1.3× imgproxy's JPEG throughput on its own benchmark, resizing in linear light at higher quality."
>
  <Hero />
  <ProofStrip />
  <Benchmarks />
  <Quality />
  <UrlGrammars />
  <UsageModes />
  <Details />
  <Limits />
</Base>
