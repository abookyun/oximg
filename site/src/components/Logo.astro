---
// Wordmark: a rust square (the oxide) followed by the name in mono.
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<span class="logo" style={`--size:${size}px`}>
  <svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true">
    <rect x="1" y="1" width="18" height="18" rx="3" fill="var(--brand)"></rect>
    <rect x="6" y="6" width="8" height="8" rx="1" fill="var(--bg)"></rect>
    <rect x="12" y="12" width="4" height="4" fill="var(--accent)"></rect>
  </svg>
  <span class="word">oximg</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: calc(var(--size) * 0.9);
    letter-spacing: -0.03em;
    color: var(--text);
  }
</style>
